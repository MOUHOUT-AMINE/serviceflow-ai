# PostgreSQL
POSTGRES_DB=serviceflow
POSTGRES_USER=serviceflow
POSTGRES_PASSWORD=change_me_for_local_development
POSTGRES_PORT=5432

# Backend
# Used when running the backend directly on the host. The backend safely builds
# its URL from the PostgreSQL values above; Compose overrides the host to postgres.
DATABASE_HOST=localhost
DATABASE_PORT=5432
# Optional full override. If set, URL-encode any reserved characters in credentials.
# DATABASE_URL=postgresql+psycopg://serviceflow:password@localhost:5432/serviceflow
TEST_DATABASE_URL=postgresql+psycopg://serviceflow:serviceflow@localhost:5433/serviceflow_test
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password
CORS_ORIGINS=http://localhost:5173
BACKEND_PORT=8000

# Frontend
# Compose uses /api so Nginx can proxy requests to the backend container.
VITE_API_URL=/api
FRONTEND_PORT=5173
