# PostgreSQL
POSTGRES_DB=serviceflow
POSTGRES_USER=serviceflow
POSTGRES_PASSWORD=serviceflow

# Backend
DATABASE_URL=postgresql+psycopg://serviceflow:serviceflow@localhost:5432/serviceflow
TEST_DATABASE_URL=postgresql+psycopg://serviceflow:serviceflow@localhost:5433/serviceflow_test
JWT_SECRET_KEY=replace_with_at_least_32_random_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=replace_with_a_strong_password

# Frontend
VITE_API_URL=http://localhost:8000
